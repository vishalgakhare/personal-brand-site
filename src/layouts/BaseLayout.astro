---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { title = "Vishal Gakhare", description = "Software Engineer" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme-mode") || "system";
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const resolved = stored === "system" ? (prefersDark ? "dark" : "light") : stored;
        document.documentElement.dataset.themeMode = stored;
        document.documentElement.dataset.theme = resolved;
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main class="wrapper">
      <slot />
    </main>
    <Footer />
  </body>
</html>
